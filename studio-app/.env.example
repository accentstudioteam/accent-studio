# Copy to .env and fill from your Supabase project settings → API.
# These are PUBLIC (shipped to the browser). Security is enforced by
# Row Level Security + the allowlist, never by hiding these values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
